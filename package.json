{
  "name": "moments",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted digital photo frame - upload from your phone, show a synced fullscreen slideshow on any screen.",
  "license": "MIT",
  "author": "Bunlong Heng",
  "homepage": "https://github.com/bunlongheng/moments#readme",
  "repository": { "type": "git", "url": "https://github.com/bunlongheng/moments.git" },
  "keywords": ["photo-frame", "slideshow", "nextjs", "self-hosted", "raspberry-pi", "digital-frame", "sharp"],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
